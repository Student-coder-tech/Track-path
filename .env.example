# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB Atlas or self-hosted MongoDB connection string (required)
# Example: mongodb+srv://user:password@cluster.example.mongodb.net/trackpath
MONGODB_URI=
# mongodb+srv://trackpath_user:<trAck.123>@trackpath-cluster.tdmpmy0.mongodb.net/trackpath?appName=Trackpath-cluster

# Optional database name override. If omitted, the database in MONGODB_URI is used.
MONGODB_DB=
# Optional: seed data/applications.json automatically when the database is empty.
SEED_ON_START=false

# Optional production frontend origin for CORS. Leave blank for same-origin deployments.
APP_URL=
